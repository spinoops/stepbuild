{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "D:/wamp64/bin/php/php8.4.24/php.exe",
      "runtimeArgs": [
        "-d", "opcache.enable_cli=1",
        "-d", "xdebug.mode=off",
        "-S", "127.0.0.1:8020",
        "-t", "backend/public",
        "backend/server.php"
      ],
      "env": { "XDEBUG_MODE": "off", "TELESCOPE_ENABLED": "false" },
      "port": 8020
    },
    {
      "name": "front",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5190
    }
  ]
}
