# =============================================================================
#  Configuration de PRODUCTION (Infomaniak mutualisé)
#  Copier ce fichier en .env SUR LE SERVEUR, puis compléter les valeurs.
#  Ne JAMAIS committer le .env réel (secrets).
#  Guide : DEPLOY.md, § 5 « Première mise en ligne ».
# =============================================================================

APP_NAME="StepBuild"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Zurich

# Un seul domaine : interface React + API (doc root -> backend/public).
# Hébergement temporaire sur le compte Step One, puis compte du client : même valeur
# tant que le domaine ne change pas.
APP_URL=https://planning.lachatconstruction.ch
FRONTEND_URL=https://planning.lachatconstruction.ch
SANCTUM_STATEFUL_DOMAINS=planning.lachatconstruction.ch
# Durée de vie des connexions (minutes) : 30 jours après connexion, 14 jours sans utilisation.
# SANCTUM_TOKEN_EXPIRATION=43200
# SANCTUM_TOKEN_INACTIVITY=20160

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_CH

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# --- Base MySQL Infomaniak (Manager > Hébergement > Bases de données) ---
DB_CONNECTION=mysql
DB_HOST=xxxxx.myd.infomaniak.com
DB_PORT=3306
DB_DATABASE=xxxxx_chantier
DB_USERNAME=xxxxx_chantier
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Aucun worker de file d'attente sur le mutualisé : tout part tout de suite.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Photos des projets et fichiers des rapports : disque privé (storage/app/private),
# servis par lien signé. Dossier à inclure dans les sauvegardes Infomaniak.
FILESYSTEM_DISK=local

# --- Mail (« mot de passe oublié », lien du premier compte) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@lachatconstruction.ch"
MAIL_FROM_NAME="${APP_NAME}"

# --- Entreprise imprimée sur les documents (défauts : Lachat Construction, config/company.php) ---
# COMPANY_NAME="Lachat Construction Sàrl"
# COMPANY_EMAIL=info@lachat-bat.ch
# COMPANY_PHONE="079 678 09 89"

# --- Sauvegardes (storage/app/private/backups) ---
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_KEEP=30
# Si mysqldump n'est pas dans le PATH du serveur (sinon repli automatique en PHP) :
# BACKUP_MYSQLDUMP=/usr/bin/mysqldump

# --- Tâche planifiée par URL : /api/cron/run/<CRON_TOKEN> (sauvegarde quotidienne) ---
# Générer : php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
CRON_TOKEN=
